Cell[CellGroupData[{

Cell["Issues", "Section",ExpressionUUID->"742fb0e5-b4a1-4680-857f-0f799f7cd8ac"],

Cell[CellGroupData[{

Cell["Reading", "Subsection",ExpressionUUID->"bd40b512-4b3b-472d-a108-c5bd105d3dba"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraIssue",
   Background->None,ExpressionUUID->"0b37f107-376d-459c-aa59-d6f95df469b4"]], 
  "InlineCode",ExpressionUUID->"f00bd296-9a5c-462e-a2a8-778ab6635ded"],
 " returns the whole record, including metadata. ",
 Cell[BoxData[Cell["JiraIssueData",
   Background->None,ExpressionUUID->"27174d76-9acb-4b84-a36f-6f710554d602"]], 
  "InlineCode",ExpressionUUID->"bc7c883e-f1a0-4a27-940b-ae5faa672e49"],
 " returns just the fields, and can narrow to one field or several. Narrowing \
is not merely cosmetic: only the requested fields are asked of the server. "
}], "Text",ExpressionUUID->"21213400-ee8c-477d-a417-33de6eb8c8ee"],

Cell[BoxData[
 RowBox[{"JiraIssue", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"431bf18f-7a5f-496b-a0aa-ea55852808ae"],

