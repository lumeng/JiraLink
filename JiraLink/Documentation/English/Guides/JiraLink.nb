4bde-80bb-75f1e8a0628e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$JiraLogRequests", "=", "False"}], ";"}]], "Input",ExpressionUUID->\
"f7cb8309-1deb-44fb-92ec-f092e94258c3"],

Cell["Migrating from versions before 1.0", "Section",ExpressionUUID->"4dd3b8bf-ca57-4eb4-8aca-6b7f85aedc78"],

Cell[TextData[{
 "The seven original functions keep their names and argument patterns. Three \
changes are visible in existing notebooks. ",
 Cell[BoxData[Cell["JiraFindIssues",
   Background->None,ExpressionUUID->"ea1a1c10-45ea-47d5-bd56-bec18ad2ab2e"]], 
  "InlineCode",ExpressionUUID->"fbe93746-853f-4567-a554-629ae727e5a6"],
 " and ",
 Cell[BoxData[Cell["JiraJqlSearch",
   Background->None,ExpressionUUID->"59a519bf-bf8a-4244-96c1-9fbad4956bee"]], 
  "InlineCode",ExpressionUUID->"cd2ef4c0-3784-4d7e-b077-28a9b4a6ab70"],
 " return associations rather than nested lists of rules. Code written \
against the old shape used ",
 Cell[BoxData[
  TemplateBox[{
   "ReplaceAll", "paclet:ref/ReplaceAll", 
    "https://reference.wolfram.com/language/ref/ReplaceAll.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "57c39278-8c26-454d-a732-95bdf6c21408"],
 ", and should now index directly. "
}], "Text",ExpressionUUID->"36652495-2de3-477b-a930-5f2c27075089"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "before", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\"\<summary\>\"", " ", "/.", " ", "#"}], ")"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"\"\<fields\>\"", " ", "/.", " ", "#"}], ")"}]}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"\"\<issues\>\"", " ", "/.", " ", "res"}], ")"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "now", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"#", "[", "\"\<fields\>\"", "]"}], ",", "\"\<summary\>\""}], 
      "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"res", "[", "\"\<issues\>\"", "]"}]}]}]}]], "Input",ExpressionUUID\
->"3915d247-c5b9-4903-a417-15100390d946"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraCreateIssue",
   Background->None,ExpressionUUID->"c56c8784-6ef3-42d7-9bff-a3e78e781a23"]], 
  "InlineCode",ExpressionUUID->"633c967d-8536-4694-9f60-e7f9af223f52"],
 " no longer forces priority to ",
 Cell[BoxData[Cell["Major",
   Background->None,ExpressionUUID->"7aad2be7-990e-49cb-9811-56c4ad21844f"]], 
  "InlineCode",ExpressionUUID->"dcd2e116-46eb-470e-a7e7-81ecd96bccf5"],
 "; pass ",
 Cell[BoxData[
  RowBox[{"\"\<Priority\>\"", "->", "\"\<Major\>\""}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1bd81b3b-d3e4-42b2-8507-446a9f1ad0fa"],
 " to keep the old behaviour. Errors arrive as ",
 Cell[BoxData[
  TemplateBox[{
   "Failure", "paclet:ref/Failure", 
    "https://reference.wolfram.com/language/ref/Failure.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "344c13e6-803c-4712-894b-66136ccf6de1"],
 " objects instead of ",
 Cell[BoxData[
  TemplateBox[{
   "$Failed", "paclet:ref/$Failed", 
    "https://reference.wolfram.com/language/ref/$Failed.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "73ee401f-6641-45b4-9384-032670a9270a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "Null", "paclet:ref/Null", 
    "https://reference.wolfram.com/language/ref/Null.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "55838e72-25cc-473c-96de-f30442519f9d"],
 " or ",
 Cell[BoxData[
  RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]], "InlineWL", "Input",
  
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "7a6e3c6e-9dca-42c4-b04e-0781be0806c4"],
 "."
}], "Text",ExpressionUUID->"bcf2f672-c3e9-4586-83eb-c784a3ca1099"],

Cell["\<\
Writes and JQL search did not previously work at all: the default request \
path discarded the HTTP method and body, so every create and delete was \
silently a no-op, and the search path sent a curl flag where an HTTP header \
belonged, so it authenticated nothing. Any code depending on those was \
already failing.\
\>", "Text",ExpressionUUID->"063ffbfd-52af-4e43-bab6-9e5c5606d36c"],

