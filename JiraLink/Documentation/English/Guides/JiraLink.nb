Cell[CellGroupData[{

Cell["Creating", "Subsection",ExpressionUUID->"53a806cf-4de0-405e-9743-b95c673e59fd"],

Cell[BoxData[
 RowBox[{"issue", "=", 
  RowBox[{"JiraCreateIssue", "[", 
   RowBox[{"\"\<PROJ\>\"", ",", "\"\<Something is broken\>\"", 
    ",", "\"\<Bug\>\""}], "]"}]}]], "Input",ExpressionUUID->"5cbce4db-8be5-\
4028-b01e-002606d26d6a"],

Cell[BoxData[
 RowBox[{"issue", "[", "\"\<key\>\"", "]"}]], "Input",ExpressionUUID->"3b728d83-3d32-4414-ae57-5d27bab4c98a"],

Cell["\<\
Additional fields go in an association. Note that Data Center identifies \
users by name. \
\>", "Text",ExpressionUUID->"39724307-3fb9-4873-9d3f-a0b3892e5d93"],

Cell[BoxData[
 RowBox[{"JiraCreateIssue", "[", 
  RowBox[{"\"\<PROJ\>\"", ",", "\"\<Localize the parser messages\>\"", 
   ",", "\"\<Bug\>\"", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"<|", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"\"\<description\>\"", "->", "\"\<Steps to reproduce ...\>\""}], 
     ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<assignee\>\"", "    ", "->", 
      RowBox[{"<|", 
       RowBox[{"\"\<name\>\"", "->", "\"\<ExUserNameEx\>\""}], "|>"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<components\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{"\"\<name\>\"", "->", "\"\<AllLanguages\>\""}], "|>"}], ",", 
        
        RowBox[{"<|", 
         RowBox[{"\"\<name\>\"", "->", "\"\<ja\>\""}], "|>"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<labels\>\"", "      ", "->", 
      RowBox[{"{", "\"\<jiralink-test\>\"", "}"}]}]}], "\[IndentingNewLine]", 
    "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Priority\>\"", "->", "\"\<Major\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<OpenQ\>\"", "    ", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"c07d45f4-0781-4147-be0d-9ea76b794044"],

Cell[TextData[{
 Cell[BoxData["\"\<Priority\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "19161f87-c5ba-44dd-ad36-c356bc333bf5"],
 " is opt-in. Earlier versions always sent priority ",
 Cell[BoxData[Cell["Major",
   Background->None,ExpressionUUID->"18bebaa3-cac4-4c94-b8db-4fedddb7ed46"]], 
  "InlineCode",ExpressionUUID->"5fa4cd4b-72c6-49f5-94dc-44ec88e27143"],
 ", which fails outright on any instance whose priority scheme has no such \
value."
}], "Text",ExpressionUUID->"d3a73c92-57d9-4d9b-a1be-fa3e712fc2f2"],

Cell["\<\
A subtask takes the parent issue key in place of the project; the project is \
inferred from it. \
\>", "Text",ExpressionUUID->"cb220a3c-c96e-4c12-827c-f71281fb1b5c"],

Cell[BoxData[
 RowBox[{"JiraCreateIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Handle the Russian case\>\"", 
   ",", "\"\<Subtask\>\"", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"<|", 
    RowBox[{"\"\<assignee\>\"", "->", 
     RowBox[{"<|", 
      RowBox[{"\"\<name\>\"", "->", "\"\<ExUserNameEx\>\""}], "|>"}]}], "|>"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"cc031fb2-bffa-4722-\
a2f0-76274c578b1c"],

Cell["Several issues can be created in one request. ", "Text",ExpressionUUID->"40d26501-1ee4-442c-aae1-377459d78f7e"],

Cell[BoxData[
 RowBox[{"JiraCreateIssues", "[", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<project\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<key\>\"", "->", "\"\<PROJ\>\""}], "|>"}]}], ",", 
      RowBox[{"\"\<summary\>\"", "->", "\"\<First\>\""}], ",", 
      RowBox[{"\"\<issuetype\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<name\>\"", "->", "\"\<Task\>\""}], "|>"}]}]}], "|>"}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<project\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<key\>\"", "->", "\"\<PROJ\>\""}], "|>"}]}], ",", 
      RowBox[{"\"\<summary\>\"", "->", "\"\<Second\>\""}], ",", 
      RowBox[{"\"\<issuetype\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<name\>\"", "->", "\"\<Task\>\""}], "|>"}]}]}], "|>"}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]], "Input",ExpressionUUID->"13b0088f-\
4e42-44bb-a6eb-cc3d82b1e0c1"]
}, Open  ]],

