Cell[CellGroupData[{

Cell["History and metadata", "Subsection",ExpressionUUID->"a92121c7-f0f6-4eda-a121-4c59b4bcb168"],

Cell[TextData[{
 "Jira Data Center has no dedicated changelog resource; history comes back \
inside the issue when ",
 StyleBox["changelog", "TI"],
 " is expanded, which ",
 Cell[BoxData[Cell["JiraIssueChangelog",
   Background->None,ExpressionUUID->"c6b405a2-13aa-431f-8430-4da6a204d216"]], 
  "InlineCode",ExpressionUUID->"752367ea-4d42-4567-a9f8-511a30f82fe4"],
 " does for you. "
}], "Text",ExpressionUUID->"a7938ab9-33d2-43fd-ab8b-02edbbf97087"],

Cell[BoxData[
 RowBox[{"JiraIssueChangelog", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",Expres\
sionUUID->"0e890233-dffb-4f66-bb94-fec9de797a8d"],

Cell[BoxData[
 RowBox[{"JiraEditMeta", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"6b24c5a3-2cfd-44f5-b142-8dcc5b623aed"],

Cell[TextData[{
 "Jira 9 removed the server-wide ",
 StyleBox["createmeta", "TI"],
 " endpoint, so a project is always required. "
}], "Text",ExpressionUUID->"c9955f04-f12e-4eba-8b3b-cbe2515da380"],

Cell[BoxData[
 RowBox[{"JiraCreateMeta", "[", "\"\<PROJ\>\"", "]"}]], "Input",ExpressionUUID->"875e20ea-1663-4916-a964-3da263c69961"],

Cell[BoxData[
 RowBox[{"JiraCreateMeta", "[", 
  RowBox[{"\"\<PROJ\>\"", ",", "10002"}], "]"}]], "Input",ExpressionUUID->\
"c162d894-c51b-49f0-8183-34fad11e84f7"]
}, Open  ]],

