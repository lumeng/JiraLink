 RowBox[{"JiraFields", "[", "]"}]], "Input",ExpressionUUID->"af930d21-7f87-42f5-a511-048e31b0081f"],

Cell[TextData[{
 "Custom fields are the ones with opaque ",
 Cell[BoxData[Cell["customfield_NNNNN",
   Background->None,ExpressionUUID->"28c8a99a-2471-4de8-8ad5-72d2c8244b35"]], 
  "InlineCode",ExpressionUUID->"c87c6fe1-fce6-4e5c-84e6-9b8a76181015"],
