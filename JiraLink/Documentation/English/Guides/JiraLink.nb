Cell[TextData[{
 "Credentials are resolved lazily, on the first request, in this order: \
options given on the call, then ",
 Cell[BoxData[Cell["$JiraConnection",
   Background->None,ExpressionUUID->"69f81348-31d8-4e00-ad30-e34e1a85eb02"]], 
  "InlineCode",ExpressionUUID->"cf5af24c-7287-4afd-8dbf-6eaa04ba44cf"],
 ", then secure storage, then the environment variables ",
 Cell[BoxData[Cell["JIRA_URL",
   Background->None,ExpressionUUID->"3a0facc6-58eb-4a78-82d5-1570619c2c6b"]], 
  "InlineCode",ExpressionUUID->"66f66aa0-94ea-4032-9251-e0784774eb3d"],
 ", ",
 Cell[BoxData[Cell["JIRA_TOKEN",
   Background->None,ExpressionUUID->"72069366-ac25-4708-9f08-0d6d636453e6"]], 
  "InlineCode",ExpressionUUID->"539b8110-0e42-4fb8-83b5-1dae4b1589f8"],
 ", ",
 Cell[BoxData[Cell["JIRA_USER",
   Background->None,ExpressionUUID->"1fb04f78-fadf-462e-af9f-2d02b42445c2"]], 
  "InlineCode",ExpressionUUID->"e1c0f1e5-328b-4bd4-972b-deade042b5d2"],
 " and ",
 Cell[BoxData[Cell["JIRA_PASSWORD",
   Background->None,ExpressionUUID->"d4bad432-7104-48ed-ada6-8957c01c4437"]], 
  "InlineCode",ExpressionUUID->"758f4f02-3f67-4f2b-91e3-bf51ecaeb41e"],
 ". Basic authentication is used automatically when a username and password \
are what is available. "
}], "Text",ExpressionUUID->"7d947060-8d3f-416b-9a70-7002e52b4658"],

Cell["\<\
JiraConnect[\"https://jira.example.com\", Authentication -> <|\"Username\" -> \
\"fred\", \"Password\" -> \"secret\"|>]\
\>", "Program",
 CellChangeTimes->{{3.99522894320923*^9, 
  3.995228949889058*^9}},ExpressionUUID->"a4df6f2a-a4e6-4ed4-8dd2-\
de3a92afe75b"],

Cell["\<\
The connection object masks its credential when displayed, so evaluating it \
in a notebook will not reveal the token. \
\>", "Text",ExpressionUUID->"d630ce65-a60d-40d4-9efd-f979ebbdc197"],

