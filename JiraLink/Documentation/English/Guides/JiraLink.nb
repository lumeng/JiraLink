Cell[TextData[{
 "Include the context path if your server has one, as above. Use ",
 StyleBox["https", "TI"],
 ", and no explicit port number: an explicit port is known to break API calls \
on this deployment."
}], "Text",ExpressionUUID->"6bd96e7e-52bb-4fdb-a39f-57c91acdf0a4"],

Cell["Verify the connection by asking Jira who you are. ", "Text",ExpressionUUID->"cd380305-634d-45fa-9e3f-53cc9eba253e"],

