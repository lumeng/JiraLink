Cell[CellGroupData[{

Cell["Searching", "Section",ExpressionUUID->"6dc12fdc-e407-4d28-a01e-c07b228adc01"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraSearch",
   Background->None,ExpressionUUID->"c83f9c9b-05b8-4260-84b0-28beff6ab7ab"]], 
  "InlineCode",ExpressionUUID->"8e507e14-605f-4719-9b4c-982a89cbe57e"],
 " runs a JQL query and follows pagination to the end, returning the matching \
issues. "
}], "Text",ExpressionUUID->"b57eb606-d146-4c6f-9126-0c781de78d57"],

Cell[BoxData[
 RowBox[{"JiraSearch", 
  "[", "\"\<project = PROJ AND assignee = currentUser() ORDER BY created DESC\
\>\"", "]"}]], "Input",ExpressionUUID->"dd0071f1-de35-4527-9aeb-0af69a15fa32"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
   "MaxItems", "paclet:ref/MaxItems", 
    "https://reference.wolfram.com/language/ref/MaxItems.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "c03beaae-7143-4a90-903c-d67dfd34f0c7"],
 " to stop early, and ",
 Cell[BoxData["\"\<Fields\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1f3845af-6995-45f5-a903-c76203bee6f2"],
 " to limit what comes back. "
}], "Text",ExpressionUUID->"a0e83cf0-7a4a-4be6-9dbe-1d3756dcae4b"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"MaxItems", "->", "20"}]}], "]"}]], "Input",ExpressionUUID->\
"8045375e-ed51-4cb3-94c9-21d55f3f90cf"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<summary\>\"", ",", "\"\<status\>\""}], "}"}], ",", 
   RowBox[{"MaxItems", "->", "50"}]}], "]"}]], "Input",ExpressionUUID->\
"ff42e2c6-d3aa-456e-a47c-1540258e2063"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraIssueCount",
   Background->None,ExpressionUUID->"78ef9737-3618-4db0-8ba4-d20b66e52796"]], 
  "InlineCode",ExpressionUUID->"616c63bb-b06f-4768-9b41-6630b58d6fa8"],
 " reports how many issues match without retrieving them. "
}], "Text",ExpressionUUID->"925a8ab4-0107-4414-bc16-a63b7741a40b"],

Cell[BoxData[
 RowBox[{"JiraIssueCount", "[", "\"\<project = PROJ AND status = Open\>\"", 
  "]"}]], "Input",ExpressionUUID->"b034930d-1d06-4971-af71-1e012fd4853f"],

Cell[BoxData[
 RowBox[{"JiraValidateJQL", "[", "\"\<project = PROJ AND status = Open\>\"", 
  "]"}]], "Input",ExpressionUUID->"cbe35b9d-e31a-4d67-b5a8-6e930f3af673"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraJqlSearch",
   Background->None,ExpressionUUID->"3cc3a88d-d03c-462b-9014-5771bfdd208c"]], 
  "InlineCode",ExpressionUUID->"4e19c8d3-209d-4a1e-ab14-2a641a8618f5"],
 " returns a single page with Jira's pagination envelope intact, for when you \
want ",
 Cell[BoxData[Cell["startAt",
   Background->None,ExpressionUUID->"2b585320-fe3e-49a1-8cdf-d17b3f8b16f3"]], 
  "InlineCode",ExpressionUUID->"ff38f7e5-d297-45d5-b5d8-6a95c88087e3"],
 ", ",
 Cell[BoxData[Cell["maxResults",
   Background->None,ExpressionUUID->"cd37fc24-4b7c-4631-a6da-0cc6ad26f951"]], 
  "InlineCode",ExpressionUUID->"b8289daf-0db1-4d16-8944-239253b1eb66"],
 " and ",
 StyleBox["total", "TI"],
 " rather than just the issues. "
}], "Text",ExpressionUUID->"0166512f-064f-46b8-b51d-dd5b57d2df6b"],

Cell[BoxData[
 RowBox[{"JiraJqlSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"\"\<MaxResults\>\"", "->", "50"}], ",", 
   RowBox[{"\"\<StartAt\>\"", "->", "0"}]}], "]"}]], "Input",ExpressionUUID->\
"bf5c7c89-9cc0-4628-8d57-cffe747784ca"],

Cell[CellGroupData[{

Cell["Quoting values safely", "Subsection",ExpressionUUID->"8a09d568-7055-41f6-929c-b983b85f51bb"],

Cell[TextData[{
 "Values containing reserved characters or reserved words must be quoted in \
JQL. ",
 Cell[BoxData[Cell["JiraJQLEscape",
   Background->None,ExpressionUUID->"3c903ec5-ec6c-400c-9f02-70a22feba22e"]], 
  "InlineCode",ExpressionUUID->"b515f8ea-0d2a-49ad-9954-d5c7c0015d29"],
 " handles the quoting and the escaping of embedded quotes and backslashes. "
}], "Text",ExpressionUUID->"2256bfa4-e8f5-45c4-bf80-577bfb8c5ba1"],

Cell[BoxData[
 RowBox[{"JiraJQLEscape", "[", "\"\<Ready to Begin\>\"", "]"}]], "Input",Expre\
ssionUUID->"36551dd9-f988-4df4-a5b6-fb807c69b90f"],

Cell[BoxData[
 RowBox[{"JiraJQLEscape", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<ja\>\"", ",", "\"\<ru\>\"", ",", "\"\<es\>\""}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"0c89be48-6cb4-41f7-bea6-d2f334f8c118"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "StringTemplate", 
   "[", "\"\<project = PROJ AND component in `` AND summary ~ ``\>\"", "]"}], 
  "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"JiraJQLEscape", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<ja\>\"", ",", "\"\<ru\>\""}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"JiraJQLEscape", "[", "\"\<word list\>\"", "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"5a21c8f7-da98-46ee-\
a691-a0eeeba6bda0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Structured results", "Subsection",ExpressionUUID->"0e1fedeb-d1e3-4464-aba7-949d5b4b62b7"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraFindIssues",
   Background->None,ExpressionUUID->"23062cfe-c7fc-4cd1-9181-c61e6d33655b"]], 
  "InlineCode",ExpressionUUID->"ef8fa1ca-0873-4e36-9297-49be38fc73df"],
 " shapes the result by issue key. Its five argument forms are unchanged from \
earlier versions, but the return value is now an association rather than a \
nested list of rules. "
}], "Text",ExpressionUUID->"66fc9e0b-9992-472f-acdc-70fe5080bd0b"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", "\"\<project = PROJ\>\"", "]"}]], "Input",Expr\
essionUUID->"e96bd6f6-146b-4245-8bdd-a7aec97e3e2c"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<Properties\>\"", ",", 
   RowBox[{"MaxItems", "->", "2"}]}], "]"}]], "Input",ExpressionUUID->\
"1346a8a3-4ec7-4aca-8830-f6db2c6717a6"],

Cell[TextData[{
 Cell[BoxData["\"\<CoreProperties\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1e13ee31-d228-45e2-9ab0-59b2be1f2b4f"],
 " drops the ",
 Cell[BoxData[Cell["customfield_NNNNN",
   Background->None,ExpressionUUID->"1d86298c-3fe7-48d2-98e3-8a25445218bf"]], 
  "InlineCode",ExpressionUUID->"0eb58d84-0977-491e-b5c7-bbc38837b495"],
 " entries, which are numerous and rarely what you want to read. "
}], "Text",ExpressionUUID->"76903cac-2df4-41d5-ba20-ae3ccea670e1"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<CoreProperties\>\"", ",", 
   RowBox[{"MaxItems", "->", "2"}]}], "]"}]], "Input",ExpressionUUID->\
"e56e7239-5905-432f-b9b3-bed3f72386a6"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<summary\>\"", ",", 
   RowBox[{"MaxItems", "->", "20"}]}], "]"}]], "Input",ExpressionUUID->\
"02d585d1-f7eb-4ccc-ba7e-08b732118eff"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<summary\>\"", ",", "\"\<assignee\>\"", 
     ",", "\"\<components\>\""}], "}"}], ",", 
   RowBox[{"MaxItems", "->", "10"}]}], "]"}]], "Input",ExpressionUUID->\
"0aabc23a-51fa-4b53-9e4c-4d900bfcb9d1"],

Cell["\<\
Because the result is an association keyed by issue key, ordinary association \
operations apply. \
\>", "Text",ExpressionUUID->"06727330-bbf4-4e89-91c3-e58b9555b9a4"],

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{"JiraFindIssues", "[", 
   RowBox[{"\"\<project = PROJ\>\"", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<summary\>\"", ",", "\"\<status\>\""}], "}"}], ",", 
    RowBox[{"MaxItems", "->", "25"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"28de6d58-b58c-43a7-b514-8a27b8efb2ac"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Pagination", "Section",ExpressionUUID->"2e9a4d8d-0a0e-454f-b934-3448e3ccc7b3"],

Cell[TextData[{
 "Functions that return lists follow pagination to the end by default; ",
 Cell[BoxData[
  RowBox[{"MaxItems", "->", "n"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "7d72389f-99a1-4310-8015-0d281420873f"],
 " stops early."
}], "Text",ExpressionUUID->"07766fe8-6fd9-4a3e-87bf-d772dbe444f7"],

Cell[TextData[{
 "Jira caps page sizes per endpoint and silently clamps anything larger, so \
the paginator believes the page size it is handed back rather than the one it \
asked for. ",
 Cell[BoxData[Cell["/search",
   Background->None,ExpressionUUID->"edb9591d-35dc-49bf-b94b-89939a1981d1"]], 
  "InlineCode",ExpressionUUID->"978f7d9d-e72e-4b56-a6ed-8a2562f2b5a6"],
 " is governed by ",
 Cell[BoxData[Cell["jira.search.views.default.max",
   Background->None,ExpressionUUID->"7b959ffa-74a6-421c-a624-29ad47a99354"]], 
  "InlineCode",ExpressionUUID->"d0a76e49-5973-4d74-a979-4d3da0f9d210"],
 ", stock 1000; ",
 Cell[BoxData[Cell["/user/assignable/search",
   Background->None,ExpressionUUID->"37b8f131-d503-41da-9051-12210c0dd1e4"]], 
  "InlineCode",ExpressionUUID->"705dc427-adac-45a0-b807-33cef3b5a73e"],
 " caps at 100; ",
 Cell[BoxData[Cell["/group/member",
   Background->None,ExpressionUUID->"4ccf3fa8-6d33-42ee-a624-26cd3357f32d"]], 
  "InlineCode",ExpressionUUID->"b22d96ca-14fc-487f-a168-ffed7f74b9f6"],
 " at 50. "
}], "Text",ExpressionUUID->"8927da92-78a5-4996-b764-fb09adbf6f65"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"MaxItems", "->", "All"}]}], "]"}]], "Input",ExpressionUUID->\
"879eefba-6a33-460f-9c19-6bbe2662cd22"],

Cell[BoxData[
 RowBox[{"JiraComments", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"MaxItems", "->", "10"}]}], "]"}]], "Input",ExpressionUUID->\
"23bb53f1-f113-409b-b869-e7a7813682a6"]
}, Open  ]],

