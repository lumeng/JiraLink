Cell["Jira Service Management", "Section",ExpressionUUID->"c4cec431-06c1-4985-9578-89e99382e4e4"],

Cell[TextData[{
 "These endpoints exist only where Jira Service Management is installed. ",
 Cell[BoxData[Cell["JiraServiceDeskInfo",
   Background->None,ExpressionUUID->"26f230e6-5eba-4765-b2f9-246b4589f8c7"]], 
  "InlineCode",ExpressionUUID->"e852179d-ec8e-4cfd-8fd8-8d7722ddf069"],
 " is the cheapest way to find out. "
}], "Text",ExpressionUUID->"e5602380-1399-49c9-aff1-ae639ffaebb3"],

Cell[BoxData[
 RowBox[{"JiraServiceDeskInfo", "[", "]"}]], "Input",ExpressionUUID->"6d570a5e-ce39-4dc5-8913-d38a0d7f1f16"],

