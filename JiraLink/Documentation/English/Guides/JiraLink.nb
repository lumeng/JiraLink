 RowBox[{"JiraApiExecute", "[", 
  RowBox[{"\"\<GET\>\"", ",", "\"\<myself\>\""}], "]"}]], "Input",ExpressionUU\
ID->"dab71078-bbd4-4155-98da-39a299a7c613"],

Cell[TextData[{
 "To see what would be sent without sending it, use ",
 Cell[BoxData[Cell["JiraRequestObject",
   Background->None,ExpressionUUID->"cef11607-0dfd-4577-9139-09ed7c514f7e"]], 
  "InlineCode",ExpressionUUID->"a45cf057-e52d-444b-af8f-ebdaaa70a5a8"],
 ". "
}], "Text",ExpressionUUID->"66d73dba-c99c-419a-a605-780f4fa5dba6"],

Cell[BoxData[
 RowBox[{"JiraRequestObject", "[", 
  RowBox[{"\"\<POST\>\"", ",", 
   RowBox[{"{", "\"\<issue\>\"", "}"}], ",", 
   RowBox[{"\"\<Body\>\"", "->", 
    RowBox[{"<|", 
     RowBox[{"\"\<fields\>\"", "->", 
      RowBox[{"<|", 
       RowBox[{"\"\<summary\>\"", "->", "\"\<x\>\""}], "|>"}]}], "|>"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"77cd9d06-2257-4050-a959-abdaf4b619ff"],

