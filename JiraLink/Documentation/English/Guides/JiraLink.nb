(* Beginning of Notebook Content *)
Notebook[{
Cell["JiraLink", "Title",ExpressionUUID->"1a520956-72d0-4395-a483-1fac88646165"],

Cell[TextData[{
 "A Wolfram Language client for the Jira REST API, targeting ",
 StyleBox["Jira Server / Data Center 9.x",
  FontWeight->Bold],
 ": platform API v2 (",
 Cell[BoxData[Cell["/rest/api/2",
   Background->None,ExpressionUUID->"3cbc72b0-0efa-48f1-a0b6-664f4f4d2fc3"]], 
  "InlineCode",ExpressionUUID->"8dfaf457-0a6b-454a-b953-f428accb9136"],
 "), the Agile API (",
 Cell[BoxData[Cell["/rest/agile/1.0",
   Background->None,ExpressionUUID->"933e2f0b-3790-4449-b6d0-af688264ce1b"]], 
  "InlineCode",ExpressionUUID->"b4cd91c7-85ea-44f1-93c1-1db7029a59f0"],
 "), Jira Service Management (",
 Cell[BoxData[Cell["/rest/servicedeskapi",
   Background->None,ExpressionUUID->"3f6c076f-ece3-4dd5-8ebd-a89009ecf4e8"]], 
  "InlineCode",ExpressionUUID->"6c37a82e-8297-463b-b063-bf4d146764bb"],
 "), and personal access tokens (",
 Cell[BoxData[Cell["/rest/pat/latest",
   Background->None,ExpressionUUID->"090e08dd-3723-4715-b734-07828467d38a"]], 
  "InlineCode",ExpressionUUID->"822412d4-8feb-4a49-97cf-fd7e90a84eab"],
 ")."
}], "Text",ExpressionUUID->"a41f3bcc-3bba-48fb-9d76-f8939b7ce61f"],

Cell[TextData[{
 "Jira Cloud's API v3 is not supported. Data Center does not serve it, and \
the two disagree about how users are identified: Data Center uses ",
 StyleBox["name", "TI"],
 " and ",
 StyleBox["key", "TI"],
 ", Cloud uses ",
 Cell[BoxData[Cell["accountId",
   Background->None,ExpressionUUID->"cf02bbdc-91e8-41b7-92ec-827f0c92d8a6"]], 
  "InlineCode",ExpressionUUID->"14a54350-73b8-4584-9c3c-f3545714da65"],
 "."
}], "Text",ExpressionUUID->"ced4fa20-4d04-46ba-bc4d-1a957884600c"],

Cell["\<\
The cells below are not evaluated in this notebook, because every one of them \
would talk to a live server. Evaluate them against your own instance. \
\>", "Text",ExpressionUUID->"d7f2247c-2e43-439f-b180-4f1ccfda66b4"],

Cell["Loading", "Section",ExpressionUUID->"0cdd96a1-de98-4ebc-8afd-976cce3570c9"],

Cell[TextData[{
 "Load as a paclet, pointing at the repository that contains the ",
 Cell[BoxData[Cell["JiraLink",
   Background->None,ExpressionUUID->"38e741c8-eda5-4e43-9f66-5d413077ee8b"]], 
  "InlineCode",ExpressionUUID->"8f8e332c-742b-4e61-8b29-682849499073"],
 " directory. "
}], "Text",ExpressionUUID->"d20a48ec-248e-4c2c-b963-32319e4e5856"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", "[", "\"\</path/to/repository-root\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<JiraLink`\>\"", "]"}]}], "Input",ExpressionUUID->\
"4f8b5eff-d2d0-4ed8-af80-9a7169f6f734"],

Cell[TextData[{
 "Loading has no side effects: it does not prompt, and it does not read any \
credential. That is what allows the package to be used from ",
 StyleBox["wolframscript", "TI"],
 " and from the test suite."
}], "Text",ExpressionUUID->"eb158b4b-4b87-4e18-ba05-52d069ecea11"],

Cell["\<\
The older route still works, and is convenient from inside this notebook. \
\>", "Text",ExpressionUUID->"bd8e53c2-fd3f-4121-bd24-afd951f353f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PrependTo", "[", 
   RowBox[{"$Path", ",", 
    RowBox[{"FileNameDrop", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"-", "4"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<JiraLink`\>\"", "]"}]}], "Input",ExpressionUUID->\
"42dbef53-4093-4572-bafe-3f9da4759780"],

Cell[BoxData["$JiraLinkVersion"], "Input",ExpressionUUID->"6a5abd72-c752-408d-9d89-e8a4f8c14e77"],

Cell["Connecting", "Section",ExpressionUUID->"23ac161d-0904-49b6-88a4-4c0f747c5d8e"],

Cell[TextData[{
 "Personal access tokens are the recommended credential on Data Center. \
Create one from your Jira profile under ",
 StyleBox["Personal Access Tokens",
  FontSlant->Italic],
 ", then store it once in the operating system's secure credential storage. "
}], "Text",ExpressionUUID->"0626bae7-6d06-42b7-ba2c-c9fd54bb9b23"],

Cell[BoxData[
 RowBox[{"JiraStoreCredential", "[", 
  RowBox[{"\"\<https://jira.wolfram.com/jira\>\"", ",", 
   RowBox[{"<|", 
    RowBox[{"\"\<Token\>\"", "->", "\"\<paste-your-token-here\>\""}], 
    "|>"}]}], "]"}]], "Input",ExpressionUUID->"6e89b80a-88c9-4b72-aca7-\
5c1a0788561c"],

Cell["Thereafter, connecting needs only the URL. ", "Text",ExpressionUUID->"fb7f6a53-9dab-4967-ae91-029ee7239af0"],

Cell[BoxData[
 RowBox[{"JiraConnect", "[", "\"\<https://jira.wolfram.com/jira\>\"", 
  "]"}]], "Input",ExpressionUUID->"9bc9bc21-add0-4d9f-ab33-c4e4a9b250bb"],

Cell[TextData[{
 "Include the context path if your server has one, as above. Use ",
 StyleBox["https", "TI"],
 ", and no explicit port number: an explicit port is known to break API calls \
on this deployment."
}], "Text",ExpressionUUID->"6bd96e7e-52bb-4fdb-a39f-57c91acdf0a4"],

Cell["Verify the connection by asking Jira who you are. ", "Text",ExpressionUUID->"cd380305-634d-45fa-9e3f-53cc9eba253e"],

Cell[BoxData[
 RowBox[{"JiraAuthenticationTest", "[", "]"}]], "Input",ExpressionUUID->"12be3070-215a-4973-b1b6-15ceee0093c3"],

Cell[BoxData[
 RowBox[{"JiraServerInfo", "[", "]"}]], "Input",ExpressionUUID->"2e881e09-9239-4c8f-a8f6-a4d664cb8d0b"],

Cell[TextData[{
 "Credentials are resolved lazily, on the first request, in this order: \
options given on the call, then ",
 Cell[BoxData[Cell["$JiraConnection",
   Background->None,ExpressionUUID->"69f81348-31d8-4e00-ad30-e34e1a85eb02"]], 
  "InlineCode",ExpressionUUID->"cf5af24c-7287-4afd-8dbf-6eaa04ba44cf"],
 ", then secure storage, then the environment variables ",
 Cell[BoxData[Cell["JIRA_URL",
   Background->None,ExpressionUUID->"3a0facc6-58eb-4a78-82d5-1570619c2c6b"]], 
  "InlineCode",ExpressionUUID->"66f66aa0-94ea-4032-9251-e0784774eb3d"],
 ", ",
 Cell[BoxData[Cell["JIRA_TOKEN",
   Background->None,ExpressionUUID->"72069366-ac25-4708-9f08-0d6d636453e6"]], 
  "InlineCode",ExpressionUUID->"539b8110-0e42-4fb8-83b5-1dae4b1589f8"],
 ", ",
 Cell[BoxData[Cell["JIRA_USER",
   Background->None,ExpressionUUID->"1fb04f78-fadf-462e-af9f-2d02b42445c2"]], 
  "InlineCode",ExpressionUUID->"e1c0f1e5-328b-4bd4-972b-deade042b5d2"],
 " and ",
 Cell[BoxData[Cell["JIRA_PASSWORD",
   Background->None,ExpressionUUID->"d4bad432-7104-48ed-ada6-8957c01c4437"]], 
  "InlineCode",ExpressionUUID->"758f4f02-3f67-4f2b-91e3-bf51ecaeb41e"],
 ". Basic authentication is used automatically when a username and password \
are what is available. "
}], "Text",ExpressionUUID->"7d947060-8d3f-416b-9a70-7002e52b4658"],

Cell[BoxData[
 RowBox[{"JiraConnect", "[", 
  RowBox[{"\"\<https://jira.example.com\>\"", ",", 
   RowBox[{"Authentication", "->", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Username\>\"", "->", "\"\<fred\>\""}], ",", 
      RowBox[{"\"\<Password\>\"", "->", "\"\<secret\>\""}]}], "|>"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"a4df6f2a-a4e6-4ed4-8dd2-de3a92afe75b"],

Cell["\<\
The connection object masks its credential when displayed, so evaluating it \
in a notebook will not reveal the token. \
\>", "Text",ExpressionUUID->"d630ce65-a60d-40d4-9efd-f979ebbdc197"],

Cell[BoxData["$JiraConnection"], "Input",ExpressionUUID->"a07f414a-4027-4fe8-8e70-15e9df895c41"],

Cell[TextData[{
 "If you used a version of this package before 1.0, your credential is in the \
encrypted file ",
 Cell[BoxData[Cell["~/.jiralinkconfig.m",
   Background->None,ExpressionUUID->"2aeefd53-98d8-4005-a122-ee27896abde9"]], 
  "InlineCode",ExpressionUUID->"ca757ff1-93f6-4678-9d3c-855a4a7e5c0c"],
 ". Import it once. "
}], "Text",ExpressionUUID->"0357523a-de21-4c66-a9e2-40763fedc7fb"],

Cell[BoxData[
 RowBox[{"JiraImportLegacyCredentials", "[", "\"\<the password you chose\>\"",
   "]"}]], "Input",ExpressionUUID->"2e2a04a7-d592-4177-af9c-02e16b875068"],

Cell["Tokens can also be managed from here. ", "Text",ExpressionUUID->"a4674354-1a93-486c-a964-57559bec5172"],

Cell[BoxData[
 RowBox[{"JiraTokens", "[", "]"}]], "Input",ExpressionUUID->"7d0611ce-fdb4-4f9d-9827-a94fe363aa6c"],

Cell[BoxData[
 RowBox[{"JiraCreateToken", "[", 
  RowBox[{"\"\<wolfram-language-client\>\"", ",", "90"}], "]"}]], "Input",Expr\
essionUUID->"0a28c4c8-3ddb-495d-a495-102a076f1f29"],

Cell["Issues", "Section",ExpressionUUID->"742fb0e5-b4a1-4680-857f-0f799f7cd8ac"],

Cell["Reading", "Subsection",ExpressionUUID->"bd40b512-4b3b-472d-a108-c5bd105d3dba"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraIssue",
   Background->None,ExpressionUUID->"0b37f107-376d-459c-aa59-d6f95df469b4"]], 
  "InlineCode",ExpressionUUID->"f00bd296-9a5c-462e-a2a8-778ab6635ded"],
 " returns the whole record, including metadata. ",
 Cell[BoxData[Cell["JiraIssueData",
   Background->None,ExpressionUUID->"27174d76-9acb-4b84-a36f-6f710554d602"]], 
  "InlineCode",ExpressionUUID->"bc7c883e-f1a0-4a27-940b-ae5faa672e49"],
 " returns just the fields, and can narrow to one field or several. Narrowing \
is not merely cosmetic: only the requested fields are asked of the server. "
}], "Text",ExpressionUUID->"21213400-ee8c-477d-a417-33de6eb8c8ee"],

Cell[BoxData[
 RowBox[{"JiraIssue", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUUID->"431bf18f-7a5f-496b-a0aa-ea55852808ae"],

Cell[BoxData[
 RowBox[{"JiraIssueData", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionU\
UID->"034ae7df-99e3-4fea-a708-387ac35560a8"],

Cell[BoxData[
 RowBox[{"JiraIssueData", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<summary\>\""}], "]"}]], "Input",Expres\
sionUUID->"a8b4fac2-f454-43c1-81d4-9e87c90b0626"],

Cell[BoxData[
 RowBox[{"JiraIssueData", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<summary\>\"", ",", "\"\<status\>\"", 
     ",", "\"\<assignee\>\""}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"a0e3be0b-9f91-4b88-9a4c-c28fd2d175ab"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Fields\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "8326b024-fe7c-48de-b09a-ebc26735d665"],
 " option accepts Jira's selector syntax, including ",
 Cell[BoxData[Cell["*all",
   Background->None,ExpressionUUID->"f2b9957f-8c68-442a-b7ef-36c2b55ea87b"]], 
  "InlineCode",ExpressionUUID->"b6d06e93-7655-4af2-8184-c642229e7e15"],
 ", ",
 Cell[BoxData[Cell["*navigable",
   Background->None,ExpressionUUID->"50f3ab74-fe22-4fbd-8158-8bc7f73544b7"]], 
  "InlineCode",ExpressionUUID->"fe42986a-a849-4244-9aed-97ad8089d324"],
 " and negation. "
}], "Text",ExpressionUUID->"5836f9ca-d1d7-418d-b180-ac93568c1104"],

Cell[BoxData[
 RowBox[{"JiraIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"\"\<Fields\>\"", "->", "\"\<*all,-comment\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"6c118d83-d72b-404f-9d70-891c34fec945"],

Cell[BoxData[
 RowBox[{"JiraIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"\"\<Expand\>\"", "->", "\"\<renderedFields\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"0530a820-2adc-4b48-a64e-2f0184db94f8"],

Cell["Creating", "Subsection",ExpressionUUID->"53a806cf-4de0-405e-9743-b95c673e59fd"],

Cell[BoxData[
 RowBox[{"issue", "=", 
  RowBox[{"JiraCreateIssue", "[", 
   RowBox[{"\"\<PROJ\>\"", ",", "\"\<Something is broken\>\"", 
    ",", "\"\<Bug\>\""}], "]"}]}]], "Input",ExpressionUUID->"5cbce4db-8be5-\
4028-b01e-002606d26d6a"],

Cell[BoxData[
 RowBox[{"issue", "[", "\"\<key\>\"", "]"}]], "Input",ExpressionUUID->"3b728d83-3d32-4414-ae57-5d27bab4c98a"],

Cell["\<\
Additional fields go in an association. Note that Data Center identifies \
users by name. \
\>", "Text",ExpressionUUID->"39724307-3fb9-4873-9d3f-a0b3892e5d93"],

Cell[BoxData[
 RowBox[{"JiraCreateIssue", "[", 
  RowBox[{"\"\<PROJ\>\"", ",", "\"\<Localize the parser messages\>\"", 
   ",", "\"\<Bug\>\"", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"<|", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"\"\<description\>\"", "->", "\"\<Steps to reproduce ...\>\""}], 
     ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<assignee\>\"", "    ", "->", 
      RowBox[{"<|", 
       RowBox[{"\"\<name\>\"", "->", "\"\<meng\>\""}], "|>"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<components\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{"\"\<name\>\"", "->", "\"\<AllLanguages\>\""}], "|>"}], ",", 
        
        RowBox[{"<|", 
         RowBox[{"\"\<name\>\"", "->", "\"\<ja\>\""}], "|>"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<labels\>\"", "      ", "->", 
      RowBox[{"{", "\"\<jiralink-test\>\"", "}"}]}]}], "\[IndentingNewLine]", 
    "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Priority\>\"", "->", "\"\<Major\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<OpenQ\>\"", "    ", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"c07d45f4-0781-4147-be0d-9ea76b794044"],

Cell[TextData[{
 Cell[BoxData["\"\<Priority\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "19161f87-c5ba-44dd-ad36-c356bc333bf5"],
 " is opt-in. Earlier versions always sent priority ",
 Cell[BoxData[Cell["Major",
   Background->None,ExpressionUUID->"18bebaa3-cac4-4c94-b8db-4fedddb7ed46"]], 
  "InlineCode",ExpressionUUID->"5fa4cd4b-72c6-49f5-94dc-44ec88e27143"],
 ", which fails outright on any instance whose priority scheme has no such \
value."
}], "Text",ExpressionUUID->"d3a73c92-57d9-4d9b-a1be-fa3e712fc2f2"],

Cell["\<\
A subtask takes the parent issue key in place of the project; the project is \
inferred from it. \
\>", "Text",ExpressionUUID->"cb220a3c-c96e-4c12-827c-f71281fb1b5c"],

Cell[BoxData[
 RowBox[{"JiraCreateIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Handle the Russian case\>\"", 
   ",", "\"\<Subtask\>\"", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"<|", 
    RowBox[{"\"\<assignee\>\"", "->", 
     RowBox[{"<|", 
      RowBox[{"\"\<name\>\"", "->", "\"\<meng\>\""}], "|>"}]}], "|>"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"cc031fb2-bffa-4722-\
a2f0-76274c578b1c"],

Cell["Several issues can be created in one request. ", "Text",ExpressionUUID->"40d26501-1ee4-442c-aae1-377459d78f7e"],

Cell[BoxData[
 RowBox[{"JiraCreateIssues", "[", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<project\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<key\>\"", "->", "\"\<PROJ\>\""}], "|>"}]}], ",", 
      RowBox[{"\"\<summary\>\"", "->", "\"\<First\>\""}], ",", 
      RowBox[{"\"\<issuetype\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<name\>\"", "->", "\"\<Task\>\""}], "|>"}]}]}], "|>"}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<project\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<key\>\"", "->", "\"\<PROJ\>\""}], "|>"}]}], ",", 
      RowBox[{"\"\<summary\>\"", "->", "\"\<Second\>\""}], ",", 
      RowBox[{"\"\<issuetype\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<name\>\"", "->", "\"\<Task\>\""}], "|>"}]}]}], "|>"}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]], "Input",ExpressionUUID->"13b0088f-\
4e42-44bb-a6eb-cc3d82b1e0c1"],

Cell["Updating, assigning, deleting", "Subsection",ExpressionUUID->"3fc769c4-beff-4152-9847-72cf9f9ba9c8"],

Cell[BoxData[
 RowBox[{"JiraUpdateIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"<|", 
    RowBox[{"\"\<summary\>\"", "->", "\"\<A better summary\>\""}], "|>"}]}], 
  "]"}]], "Input",ExpressionUUID->"363eaf56-beb9-4dd6-b17e-0c6d1f1a00ba"],

Cell[BoxData[
 RowBox[{"JiraAssignIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<meng\>\""}], "]"}]], "Input",Expressio\
nUUID->"7964c544-3994-4550-8600-418780dc5f3a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "Automatic", "paclet:ref/Automatic", 
    "https://reference.wolfram.com/language/ref/Automatic.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f39d1208-e933-4fa1-b5ae-7f0c3eaabf2a"],
 " requests the project's default assignee; ",
 Cell[BoxData[
  TemplateBox[{
   "None", "paclet:ref/None", 
    "https://reference.wolfram.com/language/ref/None.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "3c5d7fde-f2f6-4385-beb4-68cf75ebbb9e"],
 " leaves the issue unassigned. "
}], "Text",ExpressionUUID->"824ccd45-9775-47fa-af27-29e358b3b770"],

Cell[BoxData[
 RowBox[{"JiraAssignIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "Automatic"}], "]"}]], "Input",ExpressionUU\
ID->"c6325790-60f2-4af6-b4c7-4171dd351d10"],

Cell[BoxData[
 RowBox[{"JiraDeleteIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"\"\<DeleteSubtasks\>\"", "->", "True"}]}], "]"}]], "Input",Express\
ionUUID->"b9be65ae-db20-4d5d-be43-8436f47c6210"],

Cell[TextData[{
 "A successful delete returns ",
 Cell[BoxData[
  TemplateBox[{
   "Null", "paclet:ref/Null", 
    "https://reference.wolfram.com/language/ref/Null.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "5597084f-50a4-465e-b833-58b22faaf43e"],
 "; a subsequent read of the same key gives a ",
 Cell[BoxData[
  TemplateBox[{
   "Failure", "paclet:ref/Failure", 
    "https://reference.wolfram.com/language/ref/Failure.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "2022d11c-5cd4-4447-ae0c-2db1a033d6cc"],
 " carrying status 404. "
}], "Text",ExpressionUUID->"b39f777f-1616-44a3-8575-60846dfd8393"],

Cell["Transitions", "Subsection",ExpressionUUID->"cbf80be6-816f-4754-90ec-4fa17eaf4abd"],

Cell[BoxData[
 RowBox[{"JiraTransitions", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",Expressio\
nUUID->"5d4d1e3f-3e0f-4778-9a44-94acd382e808"],

Cell["\<\
Transitions may be given by name as well as by numeric id. The name is \
resolved against the transitions currently available on the issue. \
\>", "Text",ExpressionUUID->"c37b7a58-3a89-4fe0-83ce-c5b1cd3a74ae"],

Cell[BoxData[
 RowBox[{"JiraTransitionIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<In Progress\>\""}], "]"}]], "Input",Ex\
pressionUUID->"5b1c7f17-e79a-4096-abe5-951eb34212ad"],

Cell[BoxData[
 RowBox[{"JiraTransitionIssue", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Resolve Issue\>\"", ",", 
   RowBox[{"<|", 
    RowBox[{"\"\<resolution\>\"", "->", 
     RowBox[{"<|", 
      RowBox[{"\"\<name\>\"", "->", "\"\<Fixed\>\""}], "|>"}]}], "|>"}]}], 
  "]"}]], "Input",ExpressionUUID->"2c6dbe21-2c31-47a0-9543-2514224ef596"],

Cell["Comments", "Subsection",ExpressionUUID->"75bd2d09-5d97-4915-bde9-da13bbf048e6"],

Cell[BoxData[
 RowBox[{"JiraComments", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"351313b7-e382-4c9b-b2a5-97b20de258ff"],

Cell[BoxData[
 RowBox[{"JiraAddComment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Looking into it.\>\""}], 
  "]"}]], "Input",ExpressionUUID->"23f43299-f007-4a0e-b3f4-8c1f86fc54a7"],

Cell["Comments can be restricted to a role or group. ", "Text",ExpressionUUID->"592d3a5b-2c31-484c-891a-e6842cb7af58"],

Cell[BoxData[
 RowBox[{"JiraAddComment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Internal note.\>\"", ",", 
   RowBox[{"\"\<Visibility\>\"", "->", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<type\>\"", "->", "\"\<role\>\""}], ",", 
      RowBox[{"\"\<value\>\"", "->", "\"\<Developers\>\""}]}], "|>"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"3df7f9b8-5b59-4327-86a7-4b0c6eca9ef4"],

Cell[BoxData[
 RowBox[{"JiraUpdateComment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "45678", ",", "\"\<Edited text.\>\""}], 
  "]"}]], "Input",ExpressionUUID->"f2067001-4c53-4fa9-a75e-97eae3336fe8"],

Cell[BoxData[
 RowBox[{"JiraDeleteComment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "45678"}], "]"}]], "Input",ExpressionUUID->\
"86fa3ae9-85b0-4325-8108-18fb980b9497"],

Cell["Work logs", "Subsection",ExpressionUUID->"1b6d32c6-9859-402c-8219-631d6fd5912a"],

Cell[TextData[{
 "Durations may be Jira duration strings or, more naturally here, a ",
 Cell[BoxData[
  TemplateBox[{
   "Quantity", "paclet:ref/Quantity", 
    "https://reference.wolfram.com/language/ref/Quantity.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "44e4d569-4921-428b-bf35-bc48500f4066"],
 " of time. "
}], "Text",ExpressionUUID->"da2e298d-eeb9-44d7-aeed-1ed314e49fc9"],

Cell[BoxData[
 RowBox[{"JiraWorklogs", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"1cd139a2-71af-4290-aebb-cb866cef6d80"],

Cell[BoxData[
 RowBox[{"JiraAddWorklog", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"Quantity", "[", 
    RowBox[{"90", ",", "\"\<Minutes\>\""}], "]"}], ",", 
   RowBox[{"\"\<Comment\>\"", "->", "\"\<Investigating\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"5a1177e5-7303-44c4-be8b-86b3c09e083b"],

Cell[BoxData[
 RowBox[{"JiraAddWorklog", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<3h 30m\>\""}], "]"}]], "Input",Express\
ionUUID->"5c00c013-93a6-41f7-9b75-d8c75cb5be66"],

Cell["Attachments", "Subsection",ExpressionUUID->"88f6982a-2bfe-4a73-8fd8-a9838ba70650"],

Cell[BoxData[
 RowBox[{"JiraAddAttachment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\</path/to/log.txt\>\""}], 
  "]"}]], "Input",ExpressionUUID->"b76a40b4-cac1-4b29-9b70-9399c31af656"],

Cell[BoxData[
 RowBox[{"JiraAddAttachment", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\</path/to/a.png\>\"", ",", "\"\</path/to/b.png\>\""}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"356d4cfa-83d7-4cdb-b12c-\
57ef9a360435"],

Cell[BoxData[
 RowBox[{"JiraAttachmentSettings", "[", "]"}]], "Input",ExpressionUUID->"8c470b06-c3f8-4a07-b9bb-197c5f7166af"],

Cell[TextData[{
 "Attachment bytes are not served from the REST API path; ",
 Cell[BoxData[Cell["JiraAttachmentDownload",
   Background->None,ExpressionUUID->"af5052e9-7ebf-4ff1-b5e3-d9cdeb52c82e"]], 
  "InlineCode",ExpressionUUID->"eb555205-20fb-4874-9b78-e47b381cc12c"],
 " follows the content URL from the metadata, using the same credential. "
}], "Text",ExpressionUUID->"f401a78a-d980-4627-ba08-b4802ed9d893"],

Cell[BoxData[
 RowBox[{"JiraAttachmentDownload", "[", 
  RowBox[{"98765", ",", "\"\</tmp/downloaded.txt\>\""}], "]"}]], "Input",Expre\
ssionUUID->"d0e946cc-1205-46cf-92a5-f564f7efe5b7"],

Cell["Links, watchers, votes", "Subsection",ExpressionUUID->"1f072f55-1e66-418a-a756-16974d3ed7b4"],

Cell[BoxData[
 RowBox[{"JiraCreateIssueLink", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<Blocks\>\"", 
   ",", "\"\<PROJ-456\>\""}], "]"}]], "Input",ExpressionUUID->"8b0cac0a-3dec-\
4f8f-91e0-789f62fc46ea"],

Cell[BoxData[
 RowBox[{"JiraIssueLinkTypes", "[", "]"}]], "Input",ExpressionUUID->"ad134bd2-dda5-4c05-ab48-2f0f76fd0b05"],

Cell[BoxData[
 RowBox[{"JiraAddRemoteLink", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<https://example.com/build/42\>\"", 
   ",", "\"\<Build 42\>\""}], "]"}]], "Input",ExpressionUUID->"b44d6b3b-7b50-\
43a4-8501-1dcd99d60746"],

Cell[BoxData[
 RowBox[{"JiraWatchers", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"8e83bf63-8c25-4fc0-8bb1-e8295ec88b9a"],

Cell[BoxData[
 RowBox[{"JiraAddWatcher", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", "\"\<meng\>\""}], "]"}]], "Input",Expressio\
nUUID->"354d6eb5-8e77-4c75-a82e-a0f13c44ba1e"],

Cell[BoxData[
 RowBox[{"JiraVotes", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUUID->"5c584815-769b-4296-b805-7ae5e01e23a1"],

Cell["History and metadata", "Subsection",ExpressionUUID->"a92121c7-f0f6-4eda-a121-4c59b4bcb168"],

Cell[TextData[{
 "Jira Data Center has no dedicated changelog resource; history comes back \
inside the issue when ",
 StyleBox["changelog", "TI"],
 " is expanded, which ",
 Cell[BoxData[Cell["JiraIssueChangelog",
   Background->None,ExpressionUUID->"c6b405a2-13aa-431f-8430-4da6a204d216"]], 
  "InlineCode",ExpressionUUID->"752367ea-4d42-4567-a9f8-511a30f82fe4"],
 " does for you. "
}], "Text",ExpressionUUID->"a7938ab9-33d2-43fd-ab8b-02edbbf97087"],

Cell[BoxData[
 RowBox[{"JiraIssueChangelog", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",Expres\
sionUUID->"0e890233-dffb-4f66-bb94-fec9de797a8d"],

Cell[BoxData[
 RowBox[{"JiraEditMeta", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"6b24c5a3-2cfd-44f5-b142-8dcc5b623aed"],

Cell[TextData[{
 "Jira 9 removed the server-wide ",
 StyleBox["createmeta", "TI"],
 " endpoint, so a project is always required. "
}], "Text",ExpressionUUID->"c9955f04-f12e-4eba-8b3b-cbe2515da380"],

Cell[BoxData[
 RowBox[{"JiraCreateMeta", "[", "\"\<PROJ\>\"", "]"}]], "Input",ExpressionUUID->"875e20ea-1663-4916-a964-3da263c69961"],

Cell[BoxData[
 RowBox[{"JiraCreateMeta", "[", 
  RowBox[{"\"\<PROJ\>\"", ",", "10002"}], "]"}]], "Input",ExpressionUUID->\
"c162d894-c51b-49f0-8183-34fad11e84f7"],

Cell["Opening in a browser", "Subsection",ExpressionUUID->"034b9a98-2fdf-43a5-a8b1-dc22e1b1c904"],

Cell[BoxData[
 RowBox[{"JiraIssueURL", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionUU\
ID->"fbfda208-6011-4c6a-80a2-e5cfe31ab3c1"],

Cell[BoxData[
 RowBox[{"JiraIssueOpen", "[", "\"\<PROJ-123\>\"", "]"}]], "Input",ExpressionU\
UID->"47441369-0a4a-4a35-8f40-336de7955e46"],

Cell["Searching", "Section",ExpressionUUID->"6dc12fdc-e407-4d28-a01e-c07b228adc01"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraSearch",
   Background->None,ExpressionUUID->"c83f9c9b-05b8-4260-84b0-28beff6ab7ab"]], 
  "InlineCode",ExpressionUUID->"8e507e14-605f-4719-9b4c-982a89cbe57e"],
 " runs a JQL query and follows pagination to the end, returning the matching \
issues. "
}], "Text",ExpressionUUID->"b57eb606-d146-4c6f-9126-0c781de78d57"],

Cell[BoxData[
 RowBox[{"JiraSearch", 
  "[", "\"\<project = PROJ AND assignee = currentUser() ORDER BY created DESC\
\>\"", "]"}]], "Input",ExpressionUUID->"dd0071f1-de35-4527-9aeb-0af69a15fa32"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
   "MaxItems", "paclet:ref/MaxItems", 
    "https://reference.wolfram.com/language/ref/MaxItems.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "c03beaae-7143-4a90-903c-d67dfd34f0c7"],
 " to stop early, and ",
 Cell[BoxData["\"\<Fields\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1f3845af-6995-45f5-a903-c76203bee6f2"],
 " to limit what comes back. "
}], "Text",ExpressionUUID->"a0e83cf0-7a4a-4be6-9dbe-1d3756dcae4b"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"MaxItems", "->", "20"}]}], "]"}]], "Input",ExpressionUUID->\
"8045375e-ed51-4cb3-94c9-21d55f3f90cf"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<summary\>\"", ",", "\"\<status\>\""}], "}"}], ",", 
   RowBox[{"MaxItems", "->", "50"}]}], "]"}]], "Input",ExpressionUUID->\
"ff42e2c6-d3aa-456e-a47c-1540258e2063"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraIssueCount",
   Background->None,ExpressionUUID->"78ef9737-3618-4db0-8ba4-d20b66e52796"]], 
  "InlineCode",ExpressionUUID->"616c63bb-b06f-4768-9b41-6630b58d6fa8"],
 " reports how many issues match without retrieving them. "
}], "Text",ExpressionUUID->"925a8ab4-0107-4414-bc16-a63b7741a40b"],

Cell[BoxData[
 RowBox[{"JiraIssueCount", "[", "\"\<project = PROJ AND status = Open\>\"", 
  "]"}]], "Input",ExpressionUUID->"b034930d-1d06-4971-af71-1e012fd4853f"],

Cell[BoxData[
 RowBox[{"JiraValidateJQL", "[", "\"\<project = PROJ AND status = Open\>\"", 
  "]"}]], "Input",ExpressionUUID->"cbe35b9d-e31a-4d67-b5a8-6e930f3af673"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraJqlSearch",
   Background->None,ExpressionUUID->"3cc3a88d-d03c-462b-9014-5771bfdd208c"]], 
  "InlineCode",ExpressionUUID->"4e19c8d3-209d-4a1e-ab14-2a641a8618f5"],
 " returns a single page with Jira's pagination envelope intact, for when you \
want ",
 Cell[BoxData[Cell["startAt",
   Background->None,ExpressionUUID->"2b585320-fe3e-49a1-8cdf-d17b3f8b16f3"]], 
  "InlineCode",ExpressionUUID->"ff38f7e5-d297-45d5-b5d8-6a95c88087e3"],
 ", ",
 Cell[BoxData[Cell["maxResults",
   Background->None,ExpressionUUID->"cd37fc24-4b7c-4631-a6da-0cc6ad26f951"]], 
  "InlineCode",ExpressionUUID->"b8289daf-0db1-4d16-8944-239253b1eb66"],
 " and ",
 StyleBox["total", "TI"],
 " rather than just the issues. "
}], "Text",ExpressionUUID->"0166512f-064f-46b8-b51d-dd5b57d2df6b"],

Cell[BoxData[
 RowBox[{"JiraJqlSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"\"\<MaxResults\>\"", "->", "50"}], ",", 
   RowBox[{"\"\<StartAt\>\"", "->", "0"}]}], "]"}]], "Input",ExpressionUUID->\
"bf5c7c89-9cc0-4628-8d57-cffe747784ca"],

Cell["Quoting values safely", "Subsection",ExpressionUUID->"8a09d568-7055-41f6-929c-b983b85f51bb"],

Cell[TextData[{
 "Values containing reserved characters or reserved words must be quoted in \
JQL. ",
 Cell[BoxData[Cell["JiraJQLEscape",
   Background->None,ExpressionUUID->"3c903ec5-ec6c-400c-9f02-70a22feba22e"]], 
  "InlineCode",ExpressionUUID->"b515f8ea-0d2a-49ad-9954-d5c7c0015d29"],
 " handles the quoting and the escaping of embedded quotes and backslashes. "
}], "Text",ExpressionUUID->"2256bfa4-e8f5-45c4-bf80-577bfb8c5ba1"],

Cell[BoxData[
 RowBox[{"JiraJQLEscape", "[", "\"\<Ready to Begin\>\"", "]"}]], "Input",Expre\
ssionUUID->"36551dd9-f988-4df4-a5b6-fb807c69b90f"],

Cell[BoxData[
 RowBox[{"JiraJQLEscape", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<ja\>\"", ",", "\"\<ru\>\"", ",", "\"\<es\>\""}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"0c89be48-6cb4-41f7-bea6-d2f334f8c118"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "StringTemplate", 
   "[", "\"\<project = PROJ AND component in `` AND summary ~ ``\>\"", "]"}], 
  "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"JiraJQLEscape", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<ja\>\"", ",", "\"\<ru\>\""}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"JiraJQLEscape", "[", "\"\<word list\>\"", "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"5a21c8f7-da98-46ee-\
a691-a0eeeba6bda0"],

Cell["Structured results", "Subsection",ExpressionUUID->"0e1fedeb-d1e3-4464-aba7-949d5b4b62b7"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraFindIssues",
   Background->None,ExpressionUUID->"23062cfe-c7fc-4cd1-9181-c61e6d33655b"]], 
  "InlineCode",ExpressionUUID->"ef8fa1ca-0873-4e36-9297-49be38fc73df"],
 " shapes the result by issue key. Its five argument forms are unchanged from \
earlier versions, but the return value is now an association rather than a \
nested list of rules. "
}], "Text",ExpressionUUID->"66fc9e0b-9992-472f-acdc-70fe5080bd0b"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", "\"\<project = PROJ\>\"", "]"}]], "Input",Expr\
essionUUID->"e96bd6f6-146b-4245-8bdd-a7aec97e3e2c"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<Properties\>\"", ",", 
   RowBox[{"MaxItems", "->", "2"}]}], "]"}]], "Input",ExpressionUUID->\
"1346a8a3-4ec7-4aca-8830-f6db2c6717a6"],

Cell[TextData[{
 Cell[BoxData["\"\<CoreProperties\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1e13ee31-d228-45e2-9ab0-59b2be1f2b4f"],
 " drops the ",
 Cell[BoxData[Cell["customfield_NNNNN",
   Background->None,ExpressionUUID->"1d86298c-3fe7-48d2-98e3-8a25445218bf"]], 
  "InlineCode",ExpressionUUID->"0eb58d84-0977-491e-b5c7-bbc38837b495"],
 " entries, which are numerous and rarely what you want to read. "
}], "Text",ExpressionUUID->"76903cac-2df4-41d5-ba20-ae3ccea670e1"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<CoreProperties\>\"", ",", 
   RowBox[{"MaxItems", "->", "2"}]}], "]"}]], "Input",ExpressionUUID->\
"e56e7239-5905-432f-b9b3-bed3f72386a6"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", "\"\<summary\>\"", ",", 
   RowBox[{"MaxItems", "->", "20"}]}], "]"}]], "Input",ExpressionUUID->\
"02d585d1-f7eb-4ccc-ba7e-08b732118eff"],

Cell[BoxData[
 RowBox[{"JiraFindIssues", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<summary\>\"", ",", "\"\<assignee\>\"", 
     ",", "\"\<components\>\""}], "}"}], ",", 
   RowBox[{"MaxItems", "->", "10"}]}], "]"}]], "Input",ExpressionUUID->\
"0aabc23a-51fa-4b53-9e4c-4d900bfcb9d1"],

Cell["\<\
Because the result is an association keyed by issue key, ordinary association \
operations apply. \
\>", "Text",ExpressionUUID->"06727330-bbf4-4e89-91c3-e58b9555b9a4"],

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{"JiraFindIssues", "[", 
   RowBox[{"\"\<project = PROJ\>\"", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<summary\>\"", ",", "\"\<status\>\""}], "}"}], ",", 
    RowBox[{"MaxItems", "->", "25"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"28de6d58-b58c-43a7-b514-8a27b8efb2ac"],

Cell["Pagination", "Section",ExpressionUUID->"2e9a4d8d-0a0e-454f-b934-3448e3ccc7b3"],

Cell[TextData[{
 "Functions that return lists follow pagination to the end by default; ",
 Cell[BoxData[
  RowBox[{"MaxItems", "->", "n"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "7d72389f-99a1-4310-8015-0d281420873f"],
 " stops early."
}], "Text",ExpressionUUID->"07766fe8-6fd9-4a3e-87bf-d772dbe444f7"],

Cell[TextData[{
 "Jira caps page sizes per endpoint and silently clamps anything larger, so \
the paginator believes the page size it is handed back rather than the one it \
asked for. ",
 Cell[BoxData[Cell["/search",
   Background->None,ExpressionUUID->"edb9591d-35dc-49bf-b94b-89939a1981d1"]], 
  "InlineCode",ExpressionUUID->"978f7d9d-e72e-4b56-a6ed-8a2562f2b5a6"],
 " is governed by ",
 Cell[BoxData[Cell["jira.search.views.default.max",
   Background->None,ExpressionUUID->"7b959ffa-74a6-421c-a624-29ad47a99354"]], 
  "InlineCode",ExpressionUUID->"d0a76e49-5973-4d74-a979-4d3da0f9d210"],
 ", stock 1000; ",
 Cell[BoxData[Cell["/user/assignable/search",
   Background->None,ExpressionUUID->"37b8f131-d503-41da-9051-12210c0dd1e4"]], 
  "InlineCode",ExpressionUUID->"705dc427-adac-45a0-b807-33cef3b5a73e"],
 " caps at 100; ",
 Cell[BoxData[Cell["/group/member",
   Background->None,ExpressionUUID->"4ccf3fa8-6d33-42ee-a624-26cd3357f32d"]], 
  "InlineCode",ExpressionUUID->"b22d96ca-14fc-487f-a168-ffed7f74b9f6"],
 " at 50. "
}], "Text",ExpressionUUID->"8927da92-78a5-4996-b764-fb09adbf6f65"],

Cell[BoxData[
 RowBox[{"JiraSearch", "[", 
  RowBox[{"\"\<project = PROJ\>\"", ",", 
   RowBox[{"MaxItems", "->", "All"}]}], "]"}]], "Input",ExpressionUUID->\
"879eefba-6a33-460f-9c19-6bbe2662cd22"],

Cell[BoxData[
 RowBox[{"JiraComments", "[", 
  RowBox[{"\"\<PROJ-123\>\"", ",", 
   RowBox[{"MaxItems", "->", "10"}]}], "]"}]], "Input",ExpressionUUID->\
"23bb53f1-f113-409b-b869-e7a7813682a6"],

