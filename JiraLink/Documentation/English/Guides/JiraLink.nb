Cell[CellGroupData[{

Cell["Administration", "Section",ExpressionUUID->"2c4f7799-81c0-430d-9f07-c99a2c8e7b1e"],

Cell[TextData[{
 "These require Jira administrator rights, and some require Data Center \
rather than Server. Without the necessary permission they give a ",
 Cell[BoxData[
  TemplateBox[{
   "Failure", "paclet:ref/Failure", 
    "https://reference.wolfram.com/language/ref/Failure.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "f2ce2c48-35b2-4ee7-b959-ad4a742b510a"],
 " carrying status 403, which is the intended behaviour. "
}], "Text",ExpressionUUID->"757da44a-4306-4dba-b2e5-9cd59170812b"],

Cell[BoxData[
 RowBox[{"JiraWorkflows", "[", "]"}]], "Input",ExpressionUUID->"8211cd34-2742-46a4-a12e-2159d7255ba8"],

Cell[BoxData[
 RowBox[{"JiraPermissionScheme", "[", "]"}]], "Input",ExpressionUUID->"3e2e8998-0d65-445e-920c-511f255307f3"],

Cell[BoxData[
 RowBox[{"JiraScreens", "[", "]"}]], "Input",ExpressionUUID->"7431f398-2eff-4619-b0b7-d3f66dc20801"],

Cell[BoxData[
 RowBox[{"JiraApplicationProperties", "[", "]"}]], "Input",ExpressionUUID->"7445a93a-a854-402a-b16a-e74348a45b9e"],

Cell[BoxData[
 RowBox[{"JiraReindexStatus", "[", "]"}]], "Input",ExpressionUUID->"4f37d66b-014f-454b-9731-9bf26dcd1797"],

Cell[BoxData[
 RowBox[{"JiraClusterNodes", "[", "]"}]], "Input",ExpressionUUID->"42b70391-8b7a-4b5d-b7cb-5570e535f2fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Errors", "Section",ExpressionUUID->"8fab2793-49cd-40bc-8521-e13305eae83c"],

Cell[TextData[{
 "Failed requests give ",
 Cell[BoxData[
  TemplateBox[{
   "Failure", "paclet:ref/Failure", 
    "https://reference.wolfram.com/language/ref/Failure.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "5dcff787-03a4-4d07-9581-012b19a82db8"],
 " objects rather than raw data, so a failure cannot be mistaken for a \
result. "
}], "Text",ExpressionUUID->"32df890b-52b0-42a0-8f6b-0a29c8209ff6"],

Cell[BoxData[
 RowBox[{"f", "=", 
  RowBox[{"JiraIssue", "[", "\"\<NOSUCH-99999\>\"", "]"}]}]], "Input",Expressi\
onUUID->"6e9fb028-20a1-4169-a347-1b2fe83fb0e1"],

Cell[BoxData[
 RowBox[{"FailureQ", "[", "f", "]"}]], "Input",ExpressionUUID->"06da3880-19b2-4897-bc9b-0d7892740b32"],

Cell[BoxData[
 RowBox[{"f", "[", "\"\<StatusCode\>\"", "]"}]], "Input",ExpressionUUID->"e82b6255-c893-465e-a296-c3036863a02c"],

Cell[BoxData[
 RowBox[{"f", "[", "\"\<ErrorMessages\>\"", "]"}]], "Input",ExpressionUUID->"2c8a77c6-07d4-4b64-b431-016e5daedc1a"],

Cell["\<\
Field-level problems from Jira are preserved separately, keyed by field id. \
\>", "Text",ExpressionUUID->"f18c6b6f-66a2-499e-86b4-a6c62f0c48e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JiraCreateIssue", "[", 
   RowBox[{"\"\<PROJ\>\"", ",", "\"\<\>\"", ",", "\"\<Bug\>\""}], "]"}], 
  "[", "\"\<Errors\>\"", "]"}]], "Input",ExpressionUUID->"5ba2a95d-8bfc-468b-\
8e1b-a636d9a50c9f"],

Cell[TextData[{
 "The tags are ",
 Cell[BoxData[Cell["JiraHTTPError",
   Background->None,ExpressionUUID->"1c861d74-f7cb-47e0-abda-9ffc27be15a3"]], 
  "InlineCode",ExpressionUUID->"ed40db91-add6-4f02-8363-6e9aabed6d2b"],
 ", ",
 Cell[BoxData[Cell["JiraAuthenticationError",
   Background->None,ExpressionUUID->"42ce1c98-4034-4289-8424-7f2e561adb35"]], 
  "InlineCode",ExpressionUUID->"41ae4a3c-b36a-4ce1-a9ef-e00b3e08c59d"],
 " (401 and 403), ",
 Cell[BoxData[Cell["JiraNotFoundError",
   Background->None,ExpressionUUID->"6135d651-e372-4736-8805-83f7db97bfa9"]], 
  "InlineCode",ExpressionUUID->"3833e6d3-578c-44a0-acf2-559c1126d844"],
 " (404), ",
 Cell[BoxData[Cell["JiraRateLimitError",
   Background->None,ExpressionUUID->"5f770469-179d-4418-9cc2-e2209b64aa1c"]], 
  "InlineCode",ExpressionUUID->"fb7aa153-7bbd-424d-a643-329eb90ee144"],
 " (429), ",
 Cell[BoxData[Cell["JiraConnectionError",
   Background->None,ExpressionUUID->"a337acd1-c7a5-4ffc-bad6-cd2aa5304068"]], 
  "InlineCode",ExpressionUUID->"a968be58-e93c-4763-9af1-bf6b57646d4d"],
 " for network-level problems, and ",
 Cell[BoxData[Cell["JiraParseError",
   Background->None,ExpressionUUID->"ed156a6f-dd74-4097-9d21-9bc5b2e1848b"]], 
  "InlineCode",ExpressionUUID->"8aa3e09d-be2b-4944-a215-70817eed35c4"],
 ". Rate-limited requests are retried automatically, honouring Jira's ",
 Cell[BoxData[Cell["Retry-After",
   Background->None,ExpressionUUID->"ef3c82b6-6e39-4cf5-bb3b-e3308e2cb476"]], 
  "InlineCode",ExpressionUUID->"4562b3aa-f0a1-40b2-9234-50a65f18913d"],
 " header. "
}], "Text",ExpressionUUID->"ac3cfed2-5b5d-4be9-a83b-46c868ee8d98"],

Cell[BoxData[
 RowBox[{"Replace", "[", 
  RowBox[{
   RowBox[{"JiraIssue", "[", "\"\<PROJ-1\>\"", "]"}], ",", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"f_", "?", "FailureQ"}], " ", "/;", " ", 
       RowBox[{
        RowBox[{"f", "[", "\"\<StatusCode\>\"", "]"}], "===", "404"}]}], 
      ":>", "\"\<no such issue\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"f_", "?", "FailureQ"}], ":>", 
      RowBox[{"\"\<request failed: \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"f", "[", "\"\<StatusCode\>\"", "]"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"issue_", ":>", 
      RowBox[{"issue", "[", "\"\<key\>\"", "]"}]}]}], "\[IndentingNewLine]", 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"5444f90f-5767-476a-8cbd-\
34bef80ab208"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Anything not wrapped", "Section",ExpressionUUID->"5e81ed64-cfff-4f1d-aa65-5fbd6584ff03"],

Cell[TextData[{
 Cell[BoxData[Cell["JiraApiExecute",
   Background->None,ExpressionUUID->"fc8ddec8-d173-4e34-b927-7518e12f552f"]], 
  "InlineCode",ExpressionUUID->"6c75f9ab-2d19-4834-8c2d-32e3917ed4f9"],
 " reaches any endpoint directly, including those of plugins this package \
knows nothing about. "
}], "Text",ExpressionUUID->"663380b8-1a45-448f-bbae-efe6a8b7437b"],

Cell[BoxData[
 RowBox[{"JiraApiExecute", "[", 
  RowBox[{"\"\<GET\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<issue\>\"", ",", "\"\<PROJ-123\>\"", 
     ",", "\"\<comment\>\""}], "}"}], ",", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<expand\>\"", "->", "\"\<renderedBody\>\""}], "}"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"16d30507-5e7b-45ea-aadb-0666fa3e093c"],

Cell[BoxData[
 RowBox[{"JiraApiExecute", "[", 
  RowBox[{"\"\<POST\>\"", ",", 
   RowBox[{"{", "\"\<issue\>\"", "}"}], ",", 
   RowBox[{"\"\<Body\>\"", "->", 
    RowBox[{"<|", 
     RowBox[{"\"\<fields\>\"", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<project\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{"\"\<key\>\"", "->", "\"\<PROJ\>\""}], "|>"}]}], ",", 
        RowBox[{"\"\<summary\>\"", "->", "\"\<Direct\>\""}], ",", 
        RowBox[{"\"\<issuetype\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{"\"\<name\>\"", "->", "\"\<Task\>\""}], "|>"}]}]}], 
       "|>"}]}], "|>"}]}]}], "]"}]], "Input",ExpressionUUID->"c1cad1f9-df1e-\
4e45-89a4-aaaef6514b10"],

Cell[TextData[{
 Cell[BoxData["\"\<API\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "c6881e9c-7b54-4a06-8c9f-54be5808caaa"],
 " selects the API family: ",
 Cell[BoxData["\"\<platform\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "0f706ebc-c68e-4541-b1ae-12d061dcdc3d"],
 " (the default), ",
 Cell[BoxData["\"\<agile\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "82a221be-537a-4119-bb7f-1f97ce526bd8"],
 ", ",
 Cell[BoxData["\"\<servicedesk\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "cb3a7b99-eae1-4388-b9c9-ef7aefdd659a"],
 ", ",
 Cell[BoxData["\"\<pat\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "52019048-7d3d-426c-82a5-63821a38b328"],
 " or ",
 Cell[BoxData["\"\<auth\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "574ea24a-791c-4039-bca2-ade7ccf5cadc"],
 ". "
}], "Text",ExpressionUUID->"6d1eb4a2-b399-4523-99c1-fef3a6cd83df"],

Cell[BoxData[
 RowBox[{"JiraApiExecute", "[", 
  RowBox[{"\"\<GET\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<board\>\"", ",", "\"\<42\>\"", ",", "\"\<sprint\>\""}], 
    "}"}], ",", 
   RowBox[{"\"\<API\>\"", "->", "\"\<agile\>\""}]}], "]"}]], "Input",Expressio\
nUUID->"ddd34d6c-db18-4253-ac0a-d14bdf2a1923"],

Cell["A path may also be given as a string. ", "Text",ExpressionUUID->"88c96652-2aea-4e99-80ab-93981020183f"],

Cell[BoxData[
 RowBox[{"JiraApiExecute", "[", 
  RowBox[{"\"\<GET\>\"", ",", "\"\<myself\>\""}], "]"}]], "Input",ExpressionUU\
ID->"dab71078-bbd4-4155-98da-39a299a7c613"],

Cell[TextData[{
 "To see what would be sent without sending it, use ",
 Cell[BoxData[Cell["JiraRequestObject",
   Background->None,ExpressionUUID->"cef11607-0dfd-4577-9139-09ed7c514f7e"]], 
  "InlineCode",ExpressionUUID->"a45cf057-e52d-444b-af8f-ebdaaa70a5a8"],
 ". "
}], "Text",ExpressionUUID->"66d73dba-c99c-419a-a605-780f4fa5dba6"],

Cell[BoxData[
 RowBox[{"JiraRequestObject", "[", 
  RowBox[{"\"\<POST\>\"", ",", 
   RowBox[{"{", "\"\<issue\>\"", "}"}], ",", 
   RowBox[{"\"\<Body\>\"", "->", 
    RowBox[{"<|", 
     RowBox[{"\"\<fields\>\"", "->", 
      RowBox[{"<|", 
       RowBox[{"\"\<summary\>\"", "->", "\"\<x\>\""}], "|>"}]}], "|>"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"77cd9d06-2257-4050-a959-abdaf4b619ff"]
}, Open  ]],

