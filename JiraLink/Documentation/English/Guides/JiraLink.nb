Cell["Debugging", "Section",ExpressionUUID->"8681b2ca-a227-47f6-bc85-6e3898dd9035"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$JiraLogRequests", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JiraServerInfo", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"$JiraRequestLog", "[", 
  RowBox[{"[", 
   RowBox[{"-", "1"}], "]"}], "]"}]}], "Input",ExpressionUUID->"914d1b83-0442-\
4bde-80bb-75f1e8a0628e"],

