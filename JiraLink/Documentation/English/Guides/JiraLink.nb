Cell["\<\
Writes and JQL search did not previously work at all: the default request \
path discarded the HTTP method and body, so every create and delete was \
silently a no-op, and the search path sent a curl flag where an HTTP header \
belonged, so it authenticated nothing. Any code depending on those was \
already failing.\
\>", "Text",ExpressionUUID->"063ffbfd-52af-4e43-bab6-9e5c5606d36c"],

Cell[TextData[{
 "The pre-1.0 connection options ",
 Cell[BoxData["\"\<JiraWebsiteURL\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "682e0c5e-3509-437f-97fa-43c01a25267c"],
 ", ",
 Cell[BoxData["\"\<JiraWebsiteUsername\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "4f70e158-4d4d-4656-b11b-e93d0ad50aad"],
 " and ",
 Cell[BoxData["\"\<JiraWebsitePassword\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "5c915301-8e50-4e7b-ad8a-6ccdacb91359"],
 " are still accepted, so older notebooks continue to run without a ",
 Cell[BoxData[Cell["JiraConnect",
   Background->None,ExpressionUUID->"d4527591-5fce-4192-ba24-deb89a5fd599"]], 
  "InlineCode",ExpressionUUID->"503ca13b-eb6d-4c6c-ac12-dbd52acaada3"],
 ". "
}], "Text",ExpressionUUID->"95cd4e78-a274-4e57-9986-86bab8f9c667"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Testing", "Section",ExpressionUUID->"84305408-ee42-46e9-9006-e4585445f3bd"],

Cell["The offline suite needs no server and no credentials. ", "Text",ExpressionUUID->"72577409-0b63-4d58-9351-76692e66224d"],

Cell[BoxData[
 RowBox[{"TestReport", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FileNameDrop", "[", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       RowBox[{"-", "4"}]}], "]"}], ",", "\"\<JiraLink\>\"", 
     ",", "\"\<Tests\>\"", ",", "\"\<Unit.wlt\>\""}], "}"}], "]"}], 
  "]"}]], "Input",ExpressionUUID->"54b87691-fec6-4883-aae4-9d865aaaddae"],

Cell[TextData[{
 Cell[BoxData[Cell["Tests/Integration.wlt",
   Background->None,ExpressionUUID->"1c1746a9-23e4-4d79-8230-4f1473439a5e"]], 
  "InlineCode",ExpressionUUID->"38054020-34df-4652-96d7-70c9e92a1d5d"],
 " talks to a real server and is skipped unless ",
 Cell[BoxData[Cell["JIRA_URL",
   Background->None,ExpressionUUID->"d5b6638f-34c2-4fd0-bf9c-5e498b5ebd52"]], 
  "InlineCode",ExpressionUUID->"81db1f55-d764-4313-95b6-057728f3751f"],
 " is set; its write tests additionally need ",
 Cell[BoxData[Cell["JIRA_TEST_PROJECT",
   Background->None,ExpressionUUID->"670dffaa-3057-4a1b-8f3b-a18efa67dcda"]], 
  "InlineCode",ExpressionUUID->"92ab36e7-4800-4ac1-a8fa-e3908b33fc5b"],
 ", and delete everything they create. "
}], "Text",ExpressionUUID->"30aa832a-4a4f-42d5-8d7c-b0fb7cdae32f"]
}, Open  ]],

